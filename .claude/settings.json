{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/guard-generated-html.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for generated-file edits"
          }
        ]
      }
    ]
  }
}
